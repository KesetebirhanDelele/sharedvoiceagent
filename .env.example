# Copy to sharedvoiceagent/.env (gitignored). Never commit real values.
GHL_API_KEY=
GHL_LOCATION_ID=
# GHL_BASE_URL=https://services.leadconnectorhq.com

# Safe by default: shadow = no GHL write, no call. Live needs BOTH of the next two lines changed.
SVC_WRITE_MODE=shadow
SVC_SHADOW_LOG_ONLY=true
# Live writes only ever go to these GHL contact ids (the test contact). Comma separated.
SVC_ALLOWED_CONTACT_IDS=

# Optional (these are the defaults)
# SVC_FIELD_PURPOSE=call_purpose
# SVC_FIELD_ORGANIZATION=call_organization
# SVC_FIELD_SCRIPT=call_script
# SVC_FIELD_FACTS=call_facts
# SVC_DEFAULT_TIMEZONE=America/Chicago
# SVC_WINDOW_START_HOUR=8
# SVC_WINDOW_END_HOUR=20
# SVC_OPT_OUT_TAGS=do not call,do not call again,do not contact,not interested,dnc,stop
# SVC_MAX_FIELD_CHARS=4000
# SVC_LEDGER_PATH=sharedvoiceagent/ledger.jsonl
